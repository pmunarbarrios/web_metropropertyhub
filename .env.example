# n8n webhook that powers the AI chatbot (proxied through /api/public/chat when
# N8N_WEBHOOK_URL is set server-side).
VITE_N8N_WEBHOOK_URL=

# n8n webhook that receives quote form submissions.
VITE_N8N_QUOTE_WEBHOOK_URL=

# Optional server-side equivalents. When set, the browser calls the app's own
# /api/public/* proxy routes instead of hitting n8n directly, keeping the
# webhook URLs out of the frontend bundle.
N8N_WEBHOOK_URL=
N8N_QUOTE_WEBHOOK_URL=
